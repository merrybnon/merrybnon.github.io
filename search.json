---
layout: null
---
[
{% for p in site.posts %}
  {
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "date": {{ p.date | date: "%-d %b %Y" | jsonify }},
    "tags": {{ p.tags | jsonify }},
    "categories": {{ p.categories | jsonify }},
    "text": {{ p.content | strip_html | strip_newlines | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
